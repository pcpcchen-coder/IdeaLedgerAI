# Idea Ledger 本機設定（install.sh 第一次執行時複製成 ~/Library/Application Support/IdeaLedger/.env）
# 改完後執行 deploy/install.sh 重新載入。這個檔含 token，權限為 600，不要放進任何 repo。
# 這個檔會被 shell 讀取：值含空白時要加雙引號，例如 IDEA_DB="/Users/me/Library/Application Support/IdeaLedger/ledger.db"

# collector 的 Bearer token；擴充設定頁要填同一串（install.sh 第一次會自動產生）
IDEA_TOKEN=

# 資料庫（對話全文只在這裡）。不可放在 iCloud 同步的資料夾（文件、桌面、iCloud Drive）
IDEA_DB=

# 本地模型：LiteLLM Gateway 的 OpenAI 相容端點與模型名稱
LLM_BASE_URL=http://127.0.0.1:4000/v1
LLM_MODEL=
LLM_API_KEY=

# AiMemory 的本機 clone（工具只寫其中的 ledger/）。同樣不可放在 iCloud 同步的資料夾
IDEA_MEMORY_REPO=
# 1 = 每輪 pull → 寫入 → commit → push；0 = 只寫本機檔案、不推送
IDEA_GIT_PUBLISH=1

IDEA_TZ=Asia/Taipei
SUMMARY_BATCH=20
